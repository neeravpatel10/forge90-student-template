    },
    {
      "type": "contains_all",
      "label": "Runs branches with RunnableParallel and a burst limiter (Part C)",
      "points": 10,
      "path": "triage.py",
      "patterns": [
        "RunnableParallel",
        "max_bucket_size"
      ]
    },
    {
      "type": "contains_all",
      "label": "Builds the triage chain with assign, an order lookup and return_exceptions (Part D)",
      "points": 12,
      "path": "triage.py",
      "patterns": [
        "RunnablePassthrough",
        "\\.assign\\(",
        "def look_up_order",
        "needs_human",
        "return_exceptions\\s*=\\s*True"
      ]
    },
    {
      "type": "file_exists",
      "label": "day32_answers.md exists",
      "points": 5,
