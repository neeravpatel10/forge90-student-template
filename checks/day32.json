      "points": 5,
      "path": "triage.py"
    },
    {
      "type": "py_compiles",
      "label": "triage.py has no syntax errors",
      "points": 6,
      "path": "triage.py"
    },
    {
      "type": "contains_all",
      "label": "Builds prompt | model | parser chains with a rate-limited Gemini model (Part A)",
      "points": 14,
      "path": "triage.py",
      "patterns": [
        "ChatGoogleGenerativeAI",
        "InMemoryRateLimiter",
        "ChatPromptTemplate",
        "StrOutputParser",
        "\\|\\s*llm",
        "brightcart_tickets\\.json"
      ]
    },
    {
      "type": "contains_all",
      "label": "Times batch against a loop (Part B)",
      "points": 10,
      "path": "triage.py",
      "patterns": [
        "\\.batch\\(",
        "max_concurrency",
        "perf_counter|time\\.time\\("
