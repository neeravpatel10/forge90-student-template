{
  "day": "day40",
  "folder": "checkpoint2",
  "pass_mark": 80,
  "title": "Day 40: Checkpoint 2 part 1, the plan (checkpoint2/PLAN.md)",
  "checks": [
    {
      "type": "file_exists",
      "label": "checkpoint2/PLAN.md exists",
      "points": 5,
      "path": "PLAN.md"
    },
    {
      "type": "min_words",
      "label": "PLAN.md is a real plan (400+ words)",
      "points": 10,
      "path": "PLAN.md",
      "words": 400
    },
    {
      "type": "sections",
      "label": "PLAN.md has the 9 template headings",
      "points": 20,
      "path": "PLAN.md",
      "patterns": [
        "^##\\s*1\\.\\s*Use case",
        "^##\\s*2\\.\\s*Users",
        "^##\\s*3\\.\\s*Data",
        "^##\\s*4\\.\\s*Tools",
        "^##\\s*5\\.\\s*The write action",
        "^##\\s*6\\.\\s*Structured output",
        "^##\\s*7\\.\\s*Memory",
        "^##\\s*8\\.\\s*Answer key",
        "^##\\s*9\\.\\s*Risks"
      ]
    },
    {
      "type": "count_at_least",
      "label": "at least 3 tools ('- tool:' lines)",
      "points": 10,
      "path": "PLAN.md",
      "pattern": "^\\s*[-*]\\s*tool:",
      "count": 3
    },
    {
      "type": "count_at_least",
      "label": "one tool is marked (retrieval)",
      "points": 5,
      "path": "PLAN.md",
      "pattern": "^\\s*[-*]\\s*tool:.*\\(retrieval\\)",
      "count": 1
    },
    {
      "type": "contains_all",
      "label": "the write action and who approves it",
      "points": 10,
      "path": "PLAN.md",
      "patterns": [
        "^\\s*[-*]\\s*write action:",
        "^\\s*[-*]\\s*write action:.*approv",
        "\\blimit|\\bcap\\b"
      ]
    },
    {
      "type": "count_at_least",
      "label": "at least 8 answer-key tasks ('- T1:' ...)",
      "points": 15,
      "path": "PLAN.md",
      "pattern": "^\\s*[-*]\\s*T\\d+\\s*:",
      "count": 8
    },
    {
      "type": "count_at_least",
      "label": "one task is marked (unanswerable)",
      "points": 5,
      "path": "PLAN.md",
      "pattern": "^\\s*[-*]\\s*T\\d+\\s*:.*\\(unanswerable\\)",
      "count": 1
    },
    {
      "type": "count_at_least",
      "label": "at least 3 risks, each with a defence",
      "points": 5,
      "path": "PLAN.md",
      "pattern": "^\\s*[-*]\\s*risk:.*defen[cs]e",
      "count": 3
    },
    {
      "type": "contains_all",
      "label": "the data is synthetic or public",
      "points": 5,
      "path": "PLAN.md",
      "patterns": [
        "synthetic|public"
      ]
    },
    {
      "type": "no_secrets",
      "label": "No API key or .env in your repo (including git history)",
      "points": 10
    }
  ]
}