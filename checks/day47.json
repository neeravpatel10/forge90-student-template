      "path": "answer_key.jsonl",
      "pattern": "^\\s*\\{.*\\\"question\\\"",
      "count": 8
    },
    {
      "type": "contains_all",
      "label": "one task is unanswerable",
      "points": 4,
      "path": "answer_key.jsonl",
      "patterns": [
        "\\\"unanswerable\\\"\\s*:\\s*true"
      ]
    },
    {
      "type": "py_compiles",
      "label": "eval_answer_key.py has no syntax errors",
      "points": 3,
      "path": "eval_answer_key.py"
    },
    {
      "type": "contains_all",
      "label": "results/key_v0.json: the first measured run",
      "points": 5,
      "path": "results/key_v0.json",
      "patterns": [
        "\\\"score\\\""
      ]
    },
    {
      "type": "contains_all",
      "label": "results/key_final.json: the final measured run",
      "points": 5,
      "path": "results/key_final.json",
      "patterns": [
        "\\\"score\\\""
      ]
    },
    {
      "type": "no_secrets",
      "label": "No API key or .env in your repo (including git history)",
      "points": 15
    }
  ]
