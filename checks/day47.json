    {
      "type": "sections",
      "label": "README.md has a Mermaid architecture diagram, a file map and how to run it",
      "points": 10,
      "path": "README.md",
      "patterns": [
        "```mermaid",
        "file map",
        "streamlit run|cli\\.py|python app\\.py"
      ]
    },
    {
      "type": "file_exists",
      "label": "requirements.txt exists",
      "points": 3,
      "path": "requirements.txt"
    },
    {
      "type": "py_compiles",
      "label": "agent.py has no syntax errors",
      "points": 4,
      "path": "agent.py"
    },
    {
      "type": "contains_all",
      "label": "agent.py: create_agent, tools, memory, approval, a Pydantic model",
      "points": 10,
      "path": "agent.py",
      "patterns": [
        "create_agent",
        "@tool|tools\\s*=",
        "checkpointer|InMemorySaver|SqliteSaver",
        "HumanInTheLoopMiddleware|interrupt\\(",
        "BaseModel"
